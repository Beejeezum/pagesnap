{
  "manifest_version": 3,
  "name": "PageSnap",
  "version": "2.0.0",
  "description": "Capture content. Repurpose it. Screenshot, social posts, blog ideas, shareable graphics — all from one click.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-default": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Quick capture current page"
    }
  },
  "options_page": "settings/settings.html",
  "web_accessible_resources": [
    {
      "resources": [
        "editor/editor.html",
        "editor/editor.css",
        "editor/editor.js",
        "utils/annotations.js",
        "utils/social-graphics.js",
        "settings/settings.html",
        "settings/settings.css",
        "settings/settings.js",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
